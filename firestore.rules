rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validNickname(value) {
      return value is string
        && value.size() >= 2
        && value.size() <= 24
        && value.matches('^[A-Za-z0-9 _.-]+$');
    }

    function textBetween(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in groupData(groupId).memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn() && groupData(groupId).ownerId == request.auth.uid;
    }

    function validTask(data) {
      return data.keys().hasOnly(['title', 'subject', 'due', 'done', 'createdAt'])
        && data.keys().hasAll(['title', 'subject', 'due', 'done', 'createdAt'])
        && textBetween(data.title, 1, 120)
        && textBetween(data.subject, 1, 30)
        && textBetween(data.due, 0, 10)
        && data.done is bool;
    }

    function validSession(data) {
      return data.keys().hasOnly(['minutes', 'subject', 'createdAt'])
        && data.keys().hasAll(['minutes', 'subject', 'createdAt'])
        && data.minutes is int
        && data.minutes >= 1
        && data.minutes <= 180
        && textBetween(data.subject, 1, 30);
    }

    function validDeck(data) {
      return data.keys().hasOnly(['name', 'subject', 'cards', 'createdAt'])
        && data.keys().hasAll(['name', 'subject', 'cards', 'createdAt'])
        && textBetween(data.name, 1, 40)
        && textBetween(data.subject, 1, 30)
        && data.cards is list
        && data.cards.size() >= 1
        && data.cards.size() <= 100;
    }

    function validExam(data) {
      return data.keys().hasOnly(['name', 'subject', 'examDate', 'createdAt'])
        && data.keys().hasAll(['name', 'subject', 'examDate', 'createdAt'])
        && textBetween(data.name, 1, 60)
        && textBetween(data.subject, 1, 30)
        && textBetween(data.examDate, 10, 10);
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'leaderboardOptIn', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'leaderboardOptIn', 'createdAt'])
        && validNickname(request.resource.data.displayName)
        && request.resource.data.leaderboardOptIn is bool
        && request.resource.data.createdAt == request.time;
      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'leaderboardOptIn'])
        && validNickname(request.resource.data.displayName)
        && request.resource.data.leaderboardOptIn is bool
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedInAs(userId);

      match /tasks/{taskId} {
        allow read, delete: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && validTask(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if signedInAs(userId)
          && validTask(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /sessions/{sessionId} {
        allow read, delete: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && validSession(request.resource.data)
          && request.resource.data.createdAt == request.time;
      }

      match /decks/{deckId} {
        allow read, delete: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && validDeck(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if signedInAs(userId)
          && validDeck(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /exams/{examId} {
        allow read, delete: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && validExam(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if signedInAs(userId)
          && validExam(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    match /publicLeaderboard/{userId} {
      allow read: if true;
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'points', 'lastPointAt', 'joinedAt'])
        && request.resource.data.keys().hasAll(['displayName', 'points', 'lastPointAt', 'joinedAt'])
        && validNickname(request.resource.data.displayName)
        && request.resource.data.points == 0
        && request.resource.data.lastPointAt == null
        && request.resource.data.joinedAt == request.time;
      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'points', 'lastPointAt'])
        && validNickname(request.resource.data.displayName)
        && request.resource.data.joinedAt == resource.data.joinedAt
        && (
          (
            request.resource.data.points == resource.data.points
            && request.resource.data.lastPointAt == resource.data.lastPointAt
          )
          || (
            request.resource.data.points == resource.data.points + 1
            && request.resource.data.lastPointAt == request.time
            && (
              resource.data.lastPointAt == null
              || resource.data.lastPointAt + duration.value(24, 'h') <= request.time
            )
          )
        );
      allow delete: if signedInAs(userId);
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'subject', 'code', 'ownerId', 'memberIds', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'subject', 'code', 'ownerId', 'memberIds', 'createdAt'])
        && textBetween(request.resource.data.name, 2, 40)
        && textBetween(request.resource.data.subject, 1, 30)
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && (
          (
            !(request.auth.uid in resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.size() <= 30
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
          )
          || (
            request.auth.uid in resource.data.memberIds
            && resource.data.ownerId != request.auth.uid
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && !(request.auth.uid in request.resource.data.memberIds)
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          )
        );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && textBetween(request.resource.data.name, 1, 24)
          && textBetween(request.resource.data.text, 1, 500)
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid || isGroupOwner(groupId));
      }
    }

    match /groupCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['groupId', 'ownerId'])
        && request.resource.data.keys().hasAll(['groupId', 'ownerId'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.groupId is string
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.code == code
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
